emental_strategy\\validation_helper.sql', 'original_file_path': 'macros\\materializations\\incremental_strategy\\validation_helper.sql', 'unique_id': 'macro.dbt_duckdb.validate_dict_field', 'macro_sql': '{%- macro validate_dict_field(field_value, field_name, errors) -%}\n  {%- if field_value is not none and field_value is not mapping -%}\n    {%- do errors.append(field_name ~ " must be a dictionary, found: " ~ field_value) -%}\n  {%- endif -%}\n{%- endmacro -%}\n\n', 'depends_on': {'macros': []}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'field_value', 'type': None, 'description': ''}, {'name': 'field_name', 'type': None, 'description': ''}, {'name': 'errors', 'type': None, 'description': ''}], 'created_at': 1789587079.2760344, 'supported_languages': None}, 'macro.dbt_duckdb.normalize_incremental_predicates': {'name': 'normalize_incremental_predicates', 'resource_type': 'macro', 'package_name': 'dbt_duckdb', 'path': 'macros\\materializations\\incremental_strategy\\validation_helper.sql', 'original_file_path': 'macros\\materializations\\incremental_strategy\\validation_helper.sql', 'unique_id': 'macro.dbt_duckdb.normalize_incremental_predicates', 'macro_sql': '{%- macro normalize_incremental_predicates(incremental_predicates) -%}\n  {{ return(normalize_string_or_list(incremental_predicates, "incremental_predicates")) }}\n{%- endmacro -%}', 'depends_on': {'macros': ['macro.dbt_duckdb.normalize_string_or_list']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'incremental_predicates', 'type': None, 'description': ''}], 'created_at': 1789587079.2760344, 'supported_languages': None}, 'macro.dbt_duckdb.duckdb__any_value': {'name': 'duckdb__any_value', 'resource_type': 'macro', 'package_name': '