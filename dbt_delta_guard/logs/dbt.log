        {% set sql_result = default %}\n        {% else %}\n            {% set sql_result = r[0] %}\n        {% endif %}\n        \n    {%- else -%}\n    \n        {% set sql_result = default %}\n    \n    {%- endif -%}\n\n    {% do return(sql_result) %}\n\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt.statement']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'query', 'type': None, 'description': ''}, {'name': 'default', 'type': None, 'description': ''}], 'created_at': 1789587080.5578425, 'supported_languages': None}, 'macro.dbt_utils.get_tables_by_pattern_sql': {'name': 'get_tables_by_pattern_sql', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros\\sql\\get_tables_by_pattern_sql.sql', 'original_file_path': 'macros\\sql\\get_tables_by_pattern_sql.sql', 'unique_id': 'macro.dbt_utils.get_tables_by_pattern_sql', 'macro_sql': "{% macro get_tables_by_pattern_sql(schema_pattern, table_pattern, exclude='', database=target.database) %}\n    {{ return(adapter.dispatch('get_tables_by_pattern_sql', 'dbt_utils')\n        (schema_pattern, table_pattern, exclude, database)) }}\n{% endmacro %}", 'depends_on': {'macros': ['macro.dbt_utils.default__get_tables_by_pattern_sql']}, 'description': '', 'meta': {}, 'docs': {'show': True, 'node_color': None}, 'config': {'meta': {}, 'docs': {'show': True, 'node_color': None}}, 'patch_path': None, 'arguments': [{'name': 'schema_pattern', 'type': None, 'description': ''}, {'name': 'table_pattern', 'type': None, 'description': ''}, {'name': 'exclude', 'type': None, 'description': ''}, {'name': 'database', 'type': None, 'description': ''}], 'created_at': 1789587080.5605283, 'supported_languages': None}, 'macro.dbt_utils.default__get_tables_by_pattern_sql': {'name': 'default__get_tables_by_pattern_sql', 'resource_type': 'macro', 'package_name': 'dbt_utils', 'path': 'macros\\sql\